# Keep the build context small and free of secrets.
# Secrets: .env holds the Supabase SECRET key for scripts — it must never reach an image.
.env
.env.*
!.env.example
**/.npmrc
*.pem
*.key

# Dependencies and build output (rebuilt inside the image)
**/node_modules
**/dist
**/build
**/.vite
coverage
**/*.tsbuildinfo

# Not needed to build the website
.git
.github
.claude
.vscode
release
frontend/android
frontend/assets
frontend/ota.json
backend
docs
*.md
deploy/Dockerfile
compose.yaml
.dockerignore
